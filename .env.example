# Copy to .env and adjust. Never commit .env itself.

# --- persistence -----------------------------------------------------------
# SQLite by default so the project runs with no external services.
# For PostgreSQL:
# EVALNOVA_DATABASE_URL=postgresql+psycopg://evalnova:evalnova@localhost:5432/evalnova

# --- handwriting recognition (Part 1) -------------------------------------
# gemini = Google Gemini vision model, reading whole pages. Measured at 2.9%
#          character error rate on real answer booklets, against 59.7% for the
#          local model, so this is the engine of record. Page images are sent
#          to Google. Needs EVALNOVA_GEMINI_API_KEY; falls back to trocr
#          without one, or when a request fails outright.
# trocr  = local model, nothing leaves the machine (downloads once). Kept as
#          the offline fallback and as the measured baseline, not as a default.
# mock   = deterministic stand-in, no download, for offline work and CI
EVALNOVA_OCR_PROVIDER=gemini
EVALNOVA_OCR_MODEL_NAME=microsoft/trocr-small-handwritten
# auto | cpu | cuda
EVALNOVA_OCR_DEVICE=auto
EVALNOVA_OCR_MAX_LINES=40

# --- marking (Part 3) -----------------------------------------------------
# gemini = rubric marking with a Gemini text model. The model is sent the
#          question, rubric and transcribed answer, and returns a verdict per
#          criterion; the marks are computed in Python from those verdicts.
#          Mark values are never sent, so the model cannot anchor on a grade.
# mock   = deterministic keyword baseline. No key, no network, no cost. Also
#          the floor the model should be measured against.
EVALNOVA_EVALUATION_PROVIDER=gemini
# Blank uses EVALNOVA_GEMINI_MODEL. Marking benefits from a stronger model
# than transcription does, so it is separately settable.
EVALNOVA_EVALUATION_MODEL=gemini-3.1-flash-lite
# Independent readings per answer. The second is what makes the confidence
# number a measurement rather than an assertion - it is how marker agreement
# is observed - and it doubles the cost. 1 disables that signal and the result
# records it as unmeasured.
EVALNOVA_EVALUATION_SAMPLES=2

# --- Google Gemini --------------------------------------------------------
# Free key: https://aistudio.google.com/apikey  - never commit a real key.
# Check a key, and list the models it can actually reach, with:
#   .venv\Scripts\python scripts\check_gemini.py --list
# EVALNOVA_GEMINI_API_KEY=
#
# Model availability is the practical constraint, not accuracy. Google returns
# 503 "experiencing high demand" on popular models often enough to break a
# marking run, and pro models return 429 on a free tier. Verified working as of
# Nov 2026: gemini-3.1-flash-lite, gemini-3-flash-preview.
EVALNOVA_GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order when the chosen model is overloaded or unavailable, so one
# busy model slows a run down instead of failing it. The model that actually
# served each request is recorded on the result.
EVALNOVA_GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
EVALNOVA_GEMINI_TIMEOUT_SECONDS=60
# low keeps transcription fast; set empty if your model rejects it
EVALNOVA_GEMINI_THINKING_LEVEL=low

# ---- speed -------------------------------------------------------------
# Pages of a booklet, and questions within one, are independent requests.
# These cap how many are in flight at once: raise them for speed, lower them
# if Google starts answering with 429.
# The free tier allows 15 generate_content requests per minute, shared by
# transcription and marking. Holding to it avoids a 429 storm. 0 disables
# the cap - only sensible on a paid key.
EVALNOVA_GEMINI_REQUESTS_PER_MINUTE=15
EVALNOVA_OCR_MAX_CONCURRENCY=4
EVALNOVA_EVALUATION_MAX_CONCURRENCY=6
# Readings per page. 2 is what makes transcription confidence a measurement;
# 1 halves transcription time and reports confidence as unmeasured.
EVALNOVA_OCR_CONFIDENCE_SAMPLES=2
