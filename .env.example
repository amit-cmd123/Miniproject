# Copy to .env and adjust. Never commit .env itself.

# --- persistence -----------------------------------------------------------
# SQLite by default so the project runs with no external services.
# For PostgreSQL:
# EVALNOVA_DATABASE_URL=postgresql+psycopg://evalnova:evalnova@localhost:5432/evalnova

# --- handwriting recognition ----------------------------------------------
# gemini = Google Gemini vision model. By far the most accurate on real answer
#          booklets (maths, Indian handwriting, ruled paper). Sends page images
#          to Google. Needs EVALNOVA_GEMINI_API_KEY; falls back to trocr
#          without one, or when a request fails.
# trocr  = local model, nothing leaves the machine (downloads once)
# mock   = deterministic stand-in, no download, useful for offline work and CI
EVALNOVA_OCR_PROVIDER=trocr
# small reads ~10x faster than base on CPU at near-identical accuracy
EVALNOVA_OCR_MODEL_NAME=microsoft/trocr-small-handwritten
# auto | cpu | cuda
EVALNOVA_OCR_DEVICE=auto
EVALNOVA_OCR_MAX_LINES=40

# --- Gemini ---------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey  - never commit a real key.
# Check it works with:  .venv\Scripts\python scripts\check_gemini.py
# EVALNOVA_GEMINI_API_KEY=
EVALNOVA_GEMINI_MODEL=gemini-3.5-flash
# low keeps transcription fast; set empty if your model rejects it
EVALNOVA_GEMINI_THINKING_LEVEL=low

# --- Part 3 (not implemented yet) -----------------------------------------
# EVALNOVA_EVALUATION_PROVIDER=gemini
